# Xandeum RPC Endpoint
# Default: https://api.devnet.xandeum.com:8899
# For production: run your own pNode and set this to your pNode's RPC
NEXT_PUBLIC_XANDEUM_RPC=https://api.devnet.xandeum.com:8899

# Stats Service URL (for storage/uptime data from reporting pNodes)
NEXT_PUBLIC_STATS_SERVICE_URL=http://localhost:3001
